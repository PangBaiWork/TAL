{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 1
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TAL_BUILD_TESTS": "OFF",
        "TAL_COPY_OUTPUT": "ON",
        "TAL_ENABLE_LTO": "OFF"
      }
    },
    {
      "name": "linux-ninja-release",
      "displayName": "Linux x86_64 Release",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-vs2022-release",
      "displayName": "Windows x64 Release (Visual Studio 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "TAL_BUILD_TESTS": "OFF",
        "TAL_COPY_OUTPUT": "ON",
        "TAL_ENABLE_LTO": "OFF"
      }
    },
    {
      "name": "android-arm64-release",
      "displayName": "Android arm64-v8a Release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/android-arm64-release",
      "toolchainFile": "$env{ANDROID_NDK}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "CMAKE_BUILD_TYPE": "Release",
        "QBDI_LLVM_TABLEN_TOOLSCHAIN": "${sourceDir}/cmake/toolchains/linux-host.cmake"
      },
      "environment": {
        "ANDROID_NDK": "$penv{ANDROID_NDK}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-ninja-release",
      "configurePreset": "linux-ninja-release",
      "targets": [
        "tal"
      ],
      "jobs": 8
    },
    {
      "name": "windows-vs2022-release",
      "configurePreset": "windows-vs2022-release",
      "configuration": "Release",
      "targets": [
        "tal"
      ],
      "jobs": 8
    },
    {
      "name": "android-arm64-release",
      "configurePreset": "android-arm64-release",
      "targets": [
        "tal"
      ],
      "jobs": 8
    }
  ]
}
